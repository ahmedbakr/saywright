{
  "name": "@saywright/vite",
  "version": "0.2.2",
  "description": "Vite plugin for Saywright: traces every element of your running React app to its file and line, so you can point at it and say what to change. Dev server only.",
  "keywords": [
    "vite",
    "vite-plugin",
    "react",
    "saywright",
    "click-to-source",
    "click-to-component",
    "open-in-editor",
    "source-location",
    "developer-tools",
    "devtools",
    "visual-editing"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ahmedbakr/saywright/tree/main/packages/vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedbakr/saywright.git",
    "directory": "packages/vite"
  },
  "bugs": "https://github.com/ahmedbakr/saywright/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./client": {
      "source": "./src/client/index.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "magic-string": "^1.4.3"
  },
  "peerDependencies": {
    "vite": ">=4"
  }
}
