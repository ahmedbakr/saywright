    "playwright",
    "test-generation",
    "e2e-testing",
    "test-automation",
    "session-recording",
    "qa",
    "ai",
    "llm",
    "ai-agent",
    "mcp",
    "claude-code",
    "codex",
    "gemini-cli",
    "accessibility",
    "a11y",
    "wcag",
    "seo",
    "voice-control",
    "speech-to-text"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ahmedbakr/saywright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedbakr/saywright.git",
    "directory": "apps/studio"
  },
  "bugs": "https://github.com/ahmedbakr/saywright/issues",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "saywright": "bin/saywright.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
