# Copy to .env.local, or paste a key in the studio under Settings → AI, which writes .env.local for you.
# In a checkout of this repository the file goes here, at its root; installed from npm it is ~/.saywright/.env.local.
# .env.local is git-ignored and readable only by you. A key is sent to its own provider and nowhere else.
# Uncomment only what you set: a key saved in .env.local wins over the same variable in your shell. An empty line
# (OPENAI_API_KEY=) never replaces a key set in your shell.
# Every variable is described in docs/configuration.md.

# One AI is enough, and Settings → AI can also use your Claude, ChatGPT or Gemini plan, or a model on this
# computer, with no key at all (docs/ai.md).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# OpenAI-compatible providers, once added in Settings → AI → Other providers (which saves their key here).
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=

# Optional: the Google API key for “Speed for real users” (Settings → Google data saves it here too).
# PAGESPEED_API_KEY=

# Optional: the Anthropic model for changes and questions, in place of the one chosen in Settings → AI
# (the ids are in apps/studio/shared/models.ts).
# SAYWRIGHT_MODEL=

# Optional: open this running app as soon as the studio starts (what --target does). SAYWRIGHT_TARGET_ROOT is its
# code folder, for an app that can't say where its code is (one without the @saywright/vite plugin).
# SAYWRIGHT_TARGET_URL=http://localhost:3000
# SAYWRIGHT_TARGET_ROOT=/path/to/your/app

# Optional: the first port the proxy gives an app shown through it (default 5281).
# SAYWRIGHT_PROXY_PORT=5281

# Optional: where the studio finds speech models (default: speech/ in the studio's data folder).
# SAYWRIGHT_SPEECH_DIR=

# For tests and demos: answer every AI request with the deterministic test stand-in, never a real AI.
# SAYWRIGHT_AI=fake

# Not read from this file: SAYWRIGHT_HOME (set it in your shell), SAYWRIGHT_STUDIO_URL (your app's environment)
# and SAYWRIGHT_URL (the MCP settings of the app that runs `saywright mcp`).
